# ZT Suite Agent Configuration
# Copy this file to .env and modify as needed

# Network monitoring mode: flow = CICFlowMeter-backed IDS path, packet = legacy Scapy packet batches
ZT_AGENT_TRAFFIC_MODE=flow

# Network interface to capture on (leave empty for all interfaces)
# Examples: eth0, ens33, wlan0
ZT_AGENT_INTERFACE=

# Target IP to filter traffic (only capture traffic to/from this IP)
# Use this to capture only host-VM traffic. Leave empty to capture all traffic.
# Example: 192.168.1.1
ZT_AGENT_TARGET_IP=

# Logging level: DEBUG, INFO, WARNING, ERROR
ZT_AGENT_LOG_LEVEL=INFO

# Output mode for captured traffic records: stdout, file, none
ZT_AGENT_OUTPUT_MODE=file

# Output file path (used when OUTPUT_MODE=file)
ZT_AGENT_OUTPUT_FILE=./traffic.jsonl

# Batch interval for traffic records (seconds)
ZT_AGENT_BATCH_INTERVAL=60

# Emergency traffic flush threshold
ZT_AGENT_BATCH_SIZE_SOFT_LIMIT=50000

# Maximum queued traffic records before new records are dropped
ZT_AGENT_BATCH_SIZE_HARD_LIMIT=100000

# Stable agent ID. Leave empty to generate and persist one locally.
ZT_AGENT_AGENT_ID=

# Agent version included in posture reports
ZT_AGENT_AGENT_VERSION=0.1.0

# Local state directory for generated identity and future buffers
ZT_AGENT_AGENT_STATE_DIR=./data

# Enable periodic endpoint posture collection
ZT_AGENT_POSTURE_ENABLED=true

# Posture collection interval (seconds)
ZT_AGENT_POSTURE_INTERVAL=300

# Output file path for posture reports (used when OUTPUT_MODE=file)
ZT_AGENT_POSTURE_OUTPUT_FILE=./posture.jsonl

# Output file path for engineered traffic features (used when OUTPUT_MODE=file)
ZT_AGENT_FEATURE_OUTPUT_FILE=./features.jsonl

# Enable local anomaly detection
ZT_AGENT_ANOMALY_ENABLED=true

# Optional legacy packet-batch anomaly model path. Used only when TRAFFIC_MODE=packet.
ZT_AGENT_ANOMALY_MODEL_PATH=./src/ml/anomaly_model.joblib

# Anomaly score threshold for legacy packet-batch alerts
ZT_AGENT_ANOMALY_THRESHOLD=0.7

# Flow-mode IDS artifacts. These must match the CICFlowMeter schema used by /ids training.
ZT_AGENT_FLOW_MODEL_PATH=../ids/models/mlp.joblib
ZT_AGENT_FLOW_SCALER_PATH=../ids/models/scaler.joblib
ZT_AGENT_FLOW_PREDICTION_THRESHOLD=0.35
ZT_AGENT_FLOW_WINDOW_INTERVAL=60
ZT_AGENT_FLOW_WORK_DIR=./data/flow-windows
ZT_AGENT_FLOW_KEEP_ARTIFACTS=false
ZT_AGENT_CICFLOWMETER_COMMAND=cicflowmeter
ZT_AGENT_CICFLOWMETER_TIMEOUT=120
ZT_AGENT_CICFLOWMETER_VERBOSE=false

# Output file path for local alerts (used when OUTPUT_MODE=file)
ZT_AGENT_ALERT_OUTPUT_FILE=./alerts.jsonl

# Heuristic fallback thresholds
ZT_AGENT_HEURISTIC_UNIQUE_DST_PORT_THRESHOLD=30
ZT_AGENT_HEURISTIC_SYN_RATIO_THRESHOLD=0.6
ZT_AGENT_HEURISTIC_PACKETS_PER_MINUTE_THRESHOLD=1000

# Traffic capture diagnostic stats interval (seconds)
ZT_AGENT_CAPTURE_STATS_INTERVAL=30

# Backend reporting. Disabled by default for local development.
ZT_AGENT_REPORTING_ENABLED=false
ZT_AGENT_BACKEND_URL=http://localhost:8000
ZT_AGENT_AGENT_TOKEN=

# Backend device ID this token is scoped to. Register the device via user JWT first,
# then issue an agent token from POST /api/devices/{device_id}/agent-tokens.
ZT_AGENT_DEVICE_ID=
ZT_AGENT_API_TIMEOUT=10
