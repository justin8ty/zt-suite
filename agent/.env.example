# ZT Suite Agent Configuration
# Copy this file to .env and modify as needed

# Network interface to capture on (leave empty for all interfaces)
# Examples: eth0, ens33, wlan0
ZT_AGENT_INTERFACE=

# Logging level: DEBUG, INFO, WARNING, ERROR
ZT_AGENT_LOG_LEVEL=INFO

# Output mode for captured traffic records: stdout, file, none
ZT_AGENT_OUTPUT_MODE=stdout

# Output file path (required if OUTPUT_MODE=file)
ZT_AGENT_OUTPUT_FILE=
